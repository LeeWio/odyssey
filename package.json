    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "ignoreScripts": [
