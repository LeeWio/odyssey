{
  "name": "odyssey",
  "version": "1.266.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "themes:build": "node scripts/scope-heroui-pro-themes.mjs",
    "api:contract": "node scripts/check-openapi-contract.mjs",
    "api:coverage": "node scripts/check-openapi-contract.mjs --coverage",
    "api:generate": "node scripts/generate-openapi-client.mjs && prettier --write lib/features/openapi",
    "dev": "node scripts/scope-heroui-pro-themes.mjs && next dev",
    "build": "node scripts/scope-heroui-pro-themes.mjs && next build",
    "analyze": "ANALYZE=true bun run build",
    "assets:optimize": "node scripts/optimize-public-images.mjs",
    "start": "next start",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke --retries=0 --max-failures=3",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "preflight": "bun x prettier --check . && bun run lint && bun run typecheck && bun run test:unit",
    "prepare": "husky"
  },
  "dependencies": {
