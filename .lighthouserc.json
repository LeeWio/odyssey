{
  "ci": {
    "collect": {
      "startServerCommand": "bun scripts/start-lighthouse-server.mjs",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/single",
        "http://localhost:3000/single/design-foundation",
        "http://localhost:3000/moments"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories.performance": ["warn", { "minScore": 0.45 }],
        "categories.accessibility": ["error", { "minScore": 0.8 }],
        "categories.best-practices": ["error", { "minScore": 0.85 }],
        "categories.seo": ["error", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
